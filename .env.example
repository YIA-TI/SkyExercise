# Salin ke `.env` dan isi nilainya. JANGAN commit `.env`.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Strava (strava.com/settings/api) — Client ID boleh publik
VITE_STRAVA_CLIENT_ID=xxxxx
# URL callback OAuth (dev pakai port Vite). Set "Authorization Callback Domain = localhost" di Strava.
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback
